# Data files -- keep the repo light; raw/processed data is regenerated by
# running scripts/01_fetch_data.py and 02_load_to_duckdb.py, not committed.
data/raw/
data/processed/
data/warehouse.duckdb

# Credentials -- never commit these. kaggle.json normally lives outside the
# repo (~/.kaggle/kaggle.json), but this is a safety net in case it ever
# ends up inside the project folder by mistake.
kaggle.json
*.env
.env

# dbt artifacts -- regenerated by `dbt run`, not meant to be committed
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS clutter
.DS_Store
Thumbs.db
